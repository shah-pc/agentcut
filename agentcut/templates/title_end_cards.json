{
  "version": "1.0",
  "_description": "Image + text title card opener, main video clips with transitions, and branded end card.",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "black"
  },
  "output": {
    "path": "title_end_cards_out.mp4",
    "loudnorm_lufs": -14
  },
  "tracks": [
    {
      "type": "video",
      "fit": "pad",
      "clips": [
        {
          "source": "title_card.png",
          "start": 0,
          "duration": 3.0,
          "transition_in": {
            "type": "fade",
            "duration": 0.5
          }
        },
        {
          "source": "main_clip1.mp4",
          "start": 3.0,
          "in": 0,
          "out": 6.0,
          "transition_in": {
            "type": "wipeleft",
            "duration": 0.5
          }
        },
        {
          "source": "main_clip2.mp4",
          "start": 9.0,
          "in": 0,
          "out": 6.0,
          "transition_in": {
            "type": "slideup",
            "duration": 0.5
          }
        },
        {
          "source": "end_card.png",
          "start": 15.0,
          "duration": 3.0,
          "transition_in": {
            "type": "dissolve",
            "duration": 0.5
          }
        }
      ]
    },
    {
      "type": "overlay",
      "clips": [
        {
          "text": "EPISODE 01: DETERMINISTIC CUTS",
          "start": 0.3,
          "duration": 2.4,
          "x": 0.5,
          "y": 0.5,
          "scale": 0.3,
          "font_size": 58,
          "color": "yellow",
          "stroke_color": "black",
          "stroke_width": 4,
          "animation": "fade"
        },
        {
          "text": "FOLLOW FOR MORE AGENT WORKFLOWS",
          "start": 15.3,
          "duration": 2.4,
          "x": 0.5,
          "y": 0.5,
          "scale": 0.3,
          "font_size": 52,
          "color": "white",
          "stroke_color": "black",
          "stroke_width": 4,
          "animation": "bounce"
        }
      ]
    },
    {
      "type": "audio",
      "role": "music",
      "clips": [
        {
          "source": "theme_music.mp3",
          "start": 0,
          "duration": 18.0,
          "volume": 0.6,
          "fade_in": 0.8,
          "fade_out": 2.0,
          "duck_under_dialogue": false
        }
      ]
    }
  ]
}
