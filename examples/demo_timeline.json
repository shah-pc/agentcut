{
  "version": "1.0",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "black"
  },
  "output": {
    "path": "out/demo_output.mp4",
    "loudnorm_lufs": -14
  },
  "tracks": [
    {
      "type": "video",
      "fit": "pad",
      "clips": [
        {
          "source": "scene1.mp4",
          "start": 0,
          "in": 0,
          "out": 5,
          "transition_in": {
            "type": "fade",
            "duration": 0.5
          }
        },
        {
          "source": "scene2.mp4",
          "start": 5,
          "in": 0,
          "out": 5,
          "transition_in": {
            "type": "dissolve",
            "duration": 0.4
          }
        },
        {
          "source": "end_card.png",
          "start": 10,
          "duration": 2,
          "transition_in": {
            "type": "slideup",
            "duration": 0.4
          }
        }
      ]
    },
    {
      "type": "audio",
      "role": "dialogue",
      "clips": [
        {
          "source": "vo_scene1.mp3",
          "start": 0.6,
          "volume": 1.0
        },
        {
          "source": "vo_scene2.mp3",
          "start": 5.5,
          "volume": 1.0
        }
      ]
    },
    {
      "type": "audio",
      "role": "music",
      "clips": [
        {
          "source": "music.mp3",
          "start": 0,
          "duration": 12,
          "volume": 0.35,
          "fade_in": 0.5,
          "fade_out": 1.5,
          "duck_under_dialogue": true
        }
      ]
    },
    {
      "type": "captions",
      "style": {
        "font_size": 64,
        "color": "white",
        "stroke_color": "black",
        "stroke_width": 4,
        "position": "bottom",
        "bold": true
      },
      "segments": [
        {
          "start": 0.4,
          "end": 4.6,
          "text": "AgentCut builds deterministic videos from pure JSON timelines",
          "highlight": true
        },
        {
          "start": 5.2,
          "end": 9.6,
          "text": "Automatic music ducking under dialogue and EBU R128 loudnorm"
        },
        {
          "start": 9.8,
          "end": 11.8,
          "text": "اردو اور عربی کیپشنز کی مکمل سپورٹ — RTL Captions Ready"
        }
      ]
    },
    {
      "type": "overlay",
      "clips": [
        {
          "source": "emoji.png",
          "start": 1.2,
          "duration": 2.5,
          "x": 0.8,
          "y": 0.16,
          "scale": 0.18,
          "animation": "bounce"
        },
        {
          "text": "AGENTCUT v1.0.1",
          "start": 10.1,
          "duration": 1.8,
          "x": 0.5,
          "y": 0.45,
          "scale": 0.28,
          "font_size": 64,
          "color": "yellow",
          "stroke_color": "black",
          "stroke_width": 4,
          "animation": "fade"
        }
      ]
    }
  ]
}
